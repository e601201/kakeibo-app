# .env.local にコピーして値を入れる（.env.local はリポジトリに入れない）
# Supabase のダッシュボード > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# ログインを許す本人のメールアドレス（1つだけ）
ALLOWED_EMAIL=you@example.com
# 以下は画面を開かずに記録するAPI（docs/api.md）を使うときだけ
# Supabase のダッシュボード > Project Settings > API Keys > Secret keys
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
# APIを呼ぶための合い言葉。openssl rand -hex 32 などで作る
KAKEIBO_API_TOKEN=
